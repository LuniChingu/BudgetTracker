<Application x:Class="BudgetTracker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/UIColors.xaml"/>
                <ResourceDictionary Source="/Styles/Controls/IconStyles.xaml"/>
                <ResourceDictionary Source="/Styles/Controls/TextBlockStyles.xaml"/>
                <ResourceDictionary Source="/Styles/Controls/TextBoxStyles.xaml"/>
                <ResourceDictionary Source="/Styles/Controls/RadioButtonStyles.xaml"/>
                <ResourceDictionary Source="/Styles/Controls/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/Styles/Controls/DataGridStyles.xaml"/>
                <ResourceDictionary Source="Styles/Controls/ComboBoxStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Resources/Fonts/Geom.ttf#Geom</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
