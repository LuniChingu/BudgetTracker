<Window x:Class="BudgetTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sharp="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:vm="clr-namespace:BudgetTracker.ViewModels"
        xmlns:views="clr-namespace:BudgetTracker.Views"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Title="MainWindow" Height="600" Width="920">
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TransactionsViewModel}">
            <views:TransactionsView />
        </DataTemplate>
    </Window.Resources>
    
    <Border Background="#1f1f24"
            CornerRadius="20">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!--Control Bar-->
            <StackPanel x:Name="pnlControlBar" Grid.Row="0"
                        Orientation="Horizontal" FlowDirection="RightToLeft"
                        Margin="0,0,10,0"
                        Background="Transparent"
                        MouseDown="UpperBar_MouseDown">
                <Button x:Name="btnClose" 
                        Style="{StaticResource UpperBarBtn}"
                        Click="btnClose_Click">
                    <sharp:IconImage Icon="Xmark"
                                     Foreground="AliceBlue"
                                     Style="{StaticResource BarButtonIcon}"/>
                </Button>
                <Button x:Name="btnMinimize" 
                        Style="{StaticResource UpperBarBtn}"
                        Click="btnMinimize_Click">
                    <sharp:IconImage Icon="WindowMinimize"
                                     Foreground="AliceBlue"
                                     IconFont="Solid"
                                     Width="12"
                                     Style="{StaticResource BarButtonIcon}"/>
                </Button>
            </StackPanel>
            
            <!--Main Content-->
            <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
                
            <!--Side Panel-->
            <Border Grid.Column="0" CornerRadius="10,0,0,10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6">
                        <GradientStop Color="#1f1f24" Offset="0"/>
                        <GradientStop Color="#141414" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <RadioButton Style="{StaticResource SideMenuRadioButton}"
                                 GroupName="MenuNav"
                                 Margin="5,10,5,5" 
                                 IsChecked="True"
                                 Command="{Binding ShowDashboardCommand}">
                        <StackPanel Orientation="Horizontal">
                            <sharp:IconImage Icon="House"
                                             Foreground="AliceBlue"
                                             Width="22"
                                             Height="22"
                                             Margin="0,0,10,0"
                                             Style="{StaticResource BarButtonIcon}"/>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="14"
                                       FontFamily="Resources/Fonts/#Geom"
                                       Text="Dashboard"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Margin="5,5,5,5" 
                                 Style="{StaticResource SideMenuRadioButton}"
                                 GroupName="MenuNav"
                                 Command="{Binding ShowTransactionsCommand}"
                                 FontFamily="Resources/Fonts/#Geom">
                        <StackPanel Orientation="Horizontal">
                            <sharp:IconImage Icon="Chain"
                                             Foreground="AliceBlue"
                                             Width="22"
                                             Height="22"
                                             Margin="0,0,10,0"
                                             Style="{StaticResource BarButtonIcon}"/>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="14"
                                       FontFamily="Resources/Fonts/#Geom"
                                       Text="Commitments"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Margin="5,5,5,5"
                                 GroupName="MenuNav"
                                 Style="{StaticResource SideMenuRadioButton}"
                                 FontFamily="Resources/Fonts/#Geom">
                        <StackPanel Orientation="Horizontal">
                            <sharp:IconImage Icon="MoneyBillTransfer"
                                             Foreground="AliceBlue"
                                             Width="22"
                                             Height="22"
                                             Margin="0,0,10,0"
                                             Style="{StaticResource BarButtonIcon}"/>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="14"
                                       FontFamily="Resources/Fonts/#Geom"
                                       Text="Transactions"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
            
            <!--Main Section-->
            <Border Grid.Column="1" CornerRadius="0,10,10,0">
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Monthly Overview for" 
                                       FontSize="22"
                                       Foreground="White" 
                                       Margin="10,5,0,3"
                                       VerticalAlignment="Bottom"
                                       FontWeight="Bold"
                                       FontFamily="Resources/Fonts/#Lora"/>
                            <TextBlock Text="August" 
                                       FontSize="32"
                                       Foreground="CornflowerBlue" 
                                       Margin="5,5,0,0"
                                       VerticalAlignment="Bottom"
                                       FontStyle="Italic"
                                       FontWeight="Bold"
                                       FontFamily="Resources/Fonts/#Lora"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <sharp:IconImage Icon="Wallet"
                                             Foreground="CornflowerBlue"
                                             Width="25"
                                             Height="25"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource BarButtonIcon}"/>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Balance"
                                           Margin="10,0"
                                           FontSize="12"
                                           Foreground="CornflowerBlue"
                                           VerticalAlignment="top"
                                           FontFamily="Resources/Fonts/#Geom"/>
                                <TextBlock Text="999,999,999"
                                           Margin="10,0"
                                           FontSize="16"
                                           Foreground="AliceBlue"
                                           VerticalAlignment="top"
                                           FontFamily="Resources/Fonts/#Geom"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    
                    <!--Content Section / Child Views-->
                    <ContentControl Content="{Binding CurrentViewModel}"
                                    Grid.Row="1"
                                    Margin="10"/>
                    <Grid Grid.Row="1">
                        
                        <!--Dashboard view-->
                        <Grid>
                            <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="425"/>
                            <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="245"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            
                            <!--Planned Spending form-->
                            <Grid Grid.Row="1" Grid.Column="1">
                                <Button x:Name="SavePlanBtn" Content="Update" 
                                        Width="60" Margin="5,5,5,2"
                                        Style="{StaticResource GenericBtn}"
                                        FontFamily="Resources/Fonts/#Lexend"
                                        Click="SavePlanBtn_Click"/>
                            </Grid>
                        </Grid>
                        
                        <!--Transactions view-->
                        <Grid x:Name="transactionsView" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <GroupBox Header="Add New Transaction" Grid.Row="0"
                                       Margin="10"
                                      Foreground="AliceBlue" 
                                      Style="{StaticResource GenericGroupBox}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    
                                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                                        <TextBlock Text="Transaction Name: " VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtName" Text="Add name" Margin="5,0,5,0" Height="25" Width="100"/>
                                        <TextBlock Text="Date: " VerticalAlignment="Center"/>
                                        <DatePicker x:Name="dpDate" Margin="5,0,5,0" Width="110"/>
                                        <TextBlock Text="Amount: " VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtAmount" Text="0.00" Margin="5,0,5,0" Width="100"/>
                                        <TextBlock Text="Category: " VerticalAlignment="Center"/>
                                        <ComboBox x:Name="cmbCategory"
                                                  Style="{StaticResource RoundedComboBoxStyle}"
                                                  ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                                  Margin="5,0,5,0" Width="100"
                                                  FontFamily="Resources/Fonts/#Lexend">
                                            <ComboBoxItem Content="Bills" IsSelected="True"/>
                                            <ComboBoxItem Content="Transport"/>
                                            <ComboBoxItem Content="Food"/>
                                            <ComboBoxItem Content="Shopping"/>
                                            <ComboBoxItem Content="Other"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="10">
                                        <Button x:Name="BtnAddClick" Content="Add Transaction" Padding="5,0" 
                                                Style="{StaticResource GenericBtn}" FontFamily="Resources/Fonts/#Lexend"
                                                Click="BtnAdd_Click"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="Transactions" Grid.Row="1"
                                      Margin="10"
                                      Foreground="AliceBlue"
                                      FontFamily="Resources/Fonts/#Lexend"
                                      Style="{StaticResource GenericGroupBox}">
                                <DataGrid x:Name="dgTransactions"
                                          AutoGenerateColumns="False"
                                          GridLinesVisibility="Horizontal"
                                          Style="{DynamicResource TransactionsStyle}"
                                          FontFamily="Resources/Fonts/#Lexend"
                                          CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120"/>
                                        <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat='${0:F2}'}" Width="100"/>
                                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="120"/>
                                    </DataGrid.Columns>
                                    
                                </DataGrid>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>    
        </Grid>
        </Grid>
    </Border>
</Window>
