<Window x:Class="BudgetTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sharp="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Title="MainWindow" Height="600" Width="920">
    
    <Border Background="#1f1f24"
            CornerRadius="20">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!--Control Bar-->
            <StackPanel x:Name="pnlControlBar" Grid.Row="0"
                        Orientation="Horizontal" FlowDirection="RightToLeft"
                        Margin="0,0,10,0"
                        Background="Transparent"
                        MouseDown="UpperBar_MouseDown">
                <Button x:Name="btnClose" 
                        Style="{StaticResource UpperBarBtn}"
                        Click="btnClose_Click">
                    <sharp:IconImage Icon="Xmark"
                                     Foreground="AliceBlue"
                                     Style="{StaticResource BarButtonIcon}"/>
                </Button>
                <Button x:Name="btnMinimize" 
                        Style="{StaticResource UpperBarBtn}"
                        Click="btnMinimize_Click">
                    <sharp:IconImage Icon="WindowMinimize"
                                     Foreground="AliceBlue"
                                     IconFont="Solid"
                                     Width="12"
                                     Style="{StaticResource BarButtonIcon}"/>
                </Button>
            </StackPanel>
            
            <!--Main Content-->
            <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
                
            <!--Side Panel-->
            <Border Grid.Column="0" CornerRadius="10,0,0,10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6">
                        <GradientStop Color="#1f1f24" Offset="0"/>
                        <GradientStop Color="#141414" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <RadioButton x:Name="btnDashboard"
                                 Style="{StaticResource SideMenuRadioButton}"
                                 Margin="5,10,5,5" 
                                 IsChecked="True"
                                 FontFamily="Resources/Fonts/#Lexend"
                                 Checked="rbDashboard_Checked">
                        <StackPanel Orientation="Horizontal">
                            <sharp:IconImage Icon="House"
                                             Foreground="AliceBlue"
                                             Width="22"
                                             Height="22"
                                             Margin="0,0,10,0"
                                             Style="{StaticResource BarButtonIcon}"/>
                            <TextBlock VerticalAlignment="Center"> Dashboard</TextBlock>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Margin="5,5,5,5" 
                                 Style="{StaticResource SideMenuRadioButton}"
                                 FontFamily="Resources/Fonts/#Lexend"
                                 Checked="rbTransactions_Checked">
                        <StackPanel Orientation="Horizontal">
                            <sharp:IconImage Icon="MoneyBillTransfer"
                                             Foreground="AliceBlue"
                                             Width="22"
                                             Height="22"
                                             Margin="0,0,10,0"
                                             Style="{StaticResource BarButtonIcon}"/>
                            <TextBlock VerticalAlignment="Center"> Transactions</TextBlock>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
            
            <!--Main Section-->
            <Border Grid.Column="1" CornerRadius="0,10,10,0">
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Monthly Overview for" 
                                       FontSize="22"
                                       Foreground="White" 
                                       Margin="10,5,0,3"
                                       VerticalAlignment="Bottom"
                                       FontWeight="Bold"
                                       FontFamily="Resources/Fonts/#Lora"/>
                            <TextBlock Text="August" 
                                       FontSize="32"
                                       Foreground="CornflowerBlue" 
                                       Margin="5,5,0,0"
                                       VerticalAlignment="Bottom"
                                       FontStyle="Italic"
                                       FontWeight="Bold"
                                       FontFamily="Resources/Fonts/#Lora"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <sharp:IconImage Icon="Wallet"
                                             Foreground="CornflowerBlue"
                                             Width="25"
                                             Height="25"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource BarButtonIcon}"/>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Balance"
                                           Margin="10,0"
                                           FontSize="12"
                                           Foreground="CornflowerBlue"
                                           VerticalAlignment="top"
                                           FontFamily="Resources/Fonts/#Geom"/>
                                <TextBlock Text="999,999,999"
                                           Margin="10,0"
                                           FontSize="16"
                                           Foreground="AliceBlue"
                                           VerticalAlignment="top"
                                           FontFamily="Resources/Fonts/#Geom"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    
                    <!--Content Section / Child Views-->
                    <ContentControl Content=""
                                    Grid.Row="1"
                                    Margin="15"/>
                    <Grid Grid.Row="1">
                        
                        <!--Dashboard view-->
                        <Grid x:Name="dashboardView" Visibility="Visible">
                            <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="425"/>
                            <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="245"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                        
                            <!--First Row as Titles-->
                            <Grid Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Quick Look"
                                           FontFamily="Resources/Fonts/#Geom"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="AliceBlue"
                                           VerticalAlignment="Bottom"
                                           Margin="30, 0, 0, 0"/>
                            </Grid>
                            <Grid Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="Breakdown by Category"
                                           FontFamily="Resources/Fonts/#Geom"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="AliceBlue"
                                           VerticalAlignment="Bottom"
                                           Margin="30, 0, 0, 0"/>
                            </Grid>
                            
                            <!--Planned Spending form-->
                            <Grid Grid.Row="1" Grid.Column="1">
                                <Button x:Name="SavePlanBtn" Content="Update" 
                                        Width="60" Margin="5,5,5,2"
                                        Style="{StaticResource GenericBtn}"
                                        FontFamily="Resources/Fonts/#Lexend"
                                        Click="SavePlanBtn_Click"/>
                            </Grid>
                        
                            <!--Budget Table-->
                            <Grid Grid.Row="1" Grid.Column="0" Margin="10,10,10,10">
                            
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36"/> <!--Table Header Row-->
                                    <RowDefinition Height="36"/> <!--Income row-->
                                    <RowDefinition Height="36"/> <!--Needs row-->
                                    <RowDefinition Height="36"/> <!--Wants row-->
                                    <RowDefinition Height="36"/> <!--Savings row-->
                                    <RowDefinition Height="36"/> <!--total row-->
                                </Grid.RowDefinitions>
                            
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="75"/>
                                </Grid.ColumnDefinitions>
                            
                                <!--Header Row Titles-->
                                <Border Grid.Row="0" Grid.Column="0" BorderThickness="1" BorderBrush="CornflowerBlue" 
                                        CornerRadius="5,0,0,0">
                                    <TextBlock Text="CATEGORY" FontSize="12"
                                           Style="{StaticResource BudgetTableStyle}"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" BorderThickness="0, 1, 1, 1" BorderBrush="CornflowerBlue">
                                    <TextBlock Text="Goal" FontSize="14"
                                               Style="{StaticResource BudgetTableStyle}"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" BorderThickness="0, 1, 1, 1" BorderBrush="CornflowerBlue" >
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Plan" FontSize="14"
                                                   Margin="10,0,5,0"
                                                   Style="{StaticResource BudgetTableStyle}"/>
                                        <Button Background="Transparent"
                                                BorderThickness="0"
                                                Click="btnEditPlan_Click">
                                            <sharp:IconImage Icon="PenToSquare"
                                                         Foreground="AliceBlue"
                                                         Width="15"
                                                         Height="15"
                                                         Margin="5,0,5,0"
                                                         Style="{StaticResource BarButtonIcon}"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="3" BorderThickness="0, 1, 1, 1" BorderBrush="CornflowerBlue">
                                    <TextBlock Text="Actual" FontSize="14"
                                               Style="{StaticResource BudgetTableStyle}"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="4" BorderThickness="0, 1, 1, 1" BorderBrush="CornflowerBlue"
                                        CornerRadius="0,5,0,0">
                                    <TextBlock Text="Budget" FontSize="14"
                                               Style="{StaticResource BudgetTableStyle}"/>
                                </Border>
                            
                                <!--Income Row-->
                                <Border Grid.Row="1" Grid.Column="0" Background="MediumPurple" 
                                        BorderBrush="Lavender" BorderThickness="0,0,1,0">
                                    <TextBlock Text="INCOME" 
                                           Style="{StaticResource BudgetTableStyle}"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Background="MediumPurple" 
                                        BorderBrush="Lavender" BorderThickness="0,0,1,0">
                                    <TextBox x:Name="txtIncomeGoal"
                                         Text="15000.00"
                                         HorizontalAlignment="Center" 
                                         VerticalAlignment="Center"
                                         Background="Transparent"
                                         FontFamily="Resources/Fonts/#Geom"
                                         FontWeight="SemiBold"
                                         Foreground="AliceBlue"
                                         BorderThickness="0"
                                         LostFocus="TxtIncomeGoal_LostFocus"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="2" Background="MediumPurple" 
                                        BorderBrush="Lavender" BorderThickness="0,0,1,0">
                                    <TextBlock x:Name="txtIncomePlan" Text="user input" 
                                               Style="{StaticResource BudgetTableStyle}"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="3" Background="MediumPurple" 
                                        BorderBrush="Lavender" BorderThickness="0,0,1,0">
                                    <TextBlock x:Name="txtIncomeActual" Text="user input"
                                               Style="{StaticResource BudgetTableStyle}"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="4" Background="MediumPurple" 
                                        BorderBrush="Lavender">
                                    <TextBlock x:Name="txtIncomeBudget" Text="100%"
                                               Style="{StaticResource BudgetTableStyle}"/>
                                </Border>
                            
                                <!--Needs Row-->
                                <Border Grid.Row="2" Grid.Column="0" BorderThickness="1,1,1,0"
                                        Style="{StaticResource BudgetTableStrokeStyle}">
                                    <TextBlock Text="NEEDS"
                                               Style="{StaticResource BudgetTableStyle}"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="1"
                                        BorderThickness="0,1,1,0"
                                        Style="{StaticResource BudgetTableStrokeStyle}">
                                    <TextBlock x:Name="txtNeedsGoal" Text="0.00"
                                               Style="{StaticResource BudgetTableStyle}"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="2" BorderThickness="0,1,1,0"
                                        Style="{StaticResource BudgetTableStrokeStyle}">
                                    <TextBlock x:Name="txtNeedsPlan" Text="0.00"
                                               Style="{StaticResource BudgetTableStyle}"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="3" BorderThickness="0,1,1,0"
                                        Style="{StaticResource BudgetTableStrokeStyle}">
                                    <TextBlock x:Name="txtNeedsActual" Text="calculated"
                                               Style="{StaticResource BudgetTableStyle}"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="4" BorderThickness="0,1,1,0"
                                        Style="{StaticResource BudgetTableStrokeStyle}">
                                    <TextBlock x:Name="txtNeedsPercentage" Text="%%"
                                               Style="{StaticResource BudgetTableStyle}"/>
                                </Border>
                            
                                <!--Wants Row-->
                                <Border Grid.Row="3" Grid.Column="0" BorderThickness="1,1,1,0"
                                        Style="{StaticResource BudgetTableStrokeStyle}">
                                    <TextBlock Text="WANTS"
                                               Style="{StaticResource BudgetTableStyle}"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="1" BorderThickness="0,1,1,0"
                                        Style="{StaticResource BudgetTableStrokeStyle}">
                                    <TextBlock x:Name="txtWantsGoal" Text="0.00"
                                               Style="{StaticResource BudgetTableStyle}"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="2" BorderThickness="0,1,1,0"
                                        Style="{StaticResource BudgetTableStrokeStyle}">
                                    <TextBlock x:Name="txtWantsPlan" Text="0.00"
                                               Style="{StaticResource BudgetTableStyle}"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="3" BorderThickness="0,1,1,0"
                                        Style="{StaticResource BudgetTableStrokeStyle}">
                                    <TextBlock x:Name="txtWantsActual" Text="calculated"
                                               Style="{StaticResource BudgetTableStyle}"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="4" BorderThickness="0,1,1,0"
                                        Style="{StaticResource BudgetTableStrokeStyle}">
                                    <TextBlock x:Name="txtWantsPercentage" Text="%%"
                                               Style="{StaticResource BudgetTableStyle}"/>
                                </Border>
                            
                                <!--Savings Row-->
                                <Border Grid.Row="4" Grid.Column="0" BorderThickness="1,1,1,0"
                                        Style="{StaticResource BudgetTableStrokeStyle}">
                                    <TextBlock Text="SAVINGS"
                                               Style="{StaticResource BudgetTableStyle}"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="1" BorderThickness="0,1,1,0"
                                        Style="{StaticResource BudgetTableStrokeStyle}">
                                    <TextBlock x:Name="txtSavingsGoal" Text="0.00"
                                               Style="{StaticResource BudgetTableStyle}"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="2" BorderThickness="0,1,1,0"
                                        Style="{StaticResource BudgetTableStrokeStyle}">
                                    <TextBlock x:Name="txtSavingsPlan" Text="0.00"
                                               Style="{StaticResource BudgetTableStyle}"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="3" BorderThickness="0,1,1,0"
                                        Style="{StaticResource BudgetTableStrokeStyle}">
                                    <TextBlock x:Name="txtSavingsActual" Text="calculated"
                                               Style="{StaticResource BudgetTableStyle}"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="4" BorderThickness="0,1,1,0"
                                        Style="{StaticResource BudgetTableStrokeStyle}">
                                    <TextBlock x:Name="txtSavingsPercentage" Text="%%"
                                               Style="{StaticResource BudgetTableStyle}"/>
                                </Border>
                            
                                <!--Total Row-->
                                <Border Grid.Row="5" Grid.Column="0" Background="#9b8fb0" 
                                        BorderBrush="DarkSlateBlue"
                                        BorderThickness="0,2,0,0"
                                        CornerRadius="0,0,0,5">
                                    <TextBlock Text="TOTAL" 
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Resources/Fonts/#Geom"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="1" Background="#9b8fb0" 
                                        BorderBrush="DarkSlateBlue"
                                        BorderThickness="0,2,0,0">
                                    <TextBlock x:Name="txtTotalGoal"
                                           Text="0.00"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Resources/Fonts/#Geom"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="2" Background="#9b8fb0" 
                                        BorderBrush="DarkSlateBlue"
                                        BorderThickness="0,2,0,0">
                                    <TextBlock Text="0.00"
                                           x:Name="txtTotalPlan"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Resources/Fonts/#Geom"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="3" Background="#9b8fb0" 
                                        BorderBrush="DarkSlateBlue"
                                        BorderThickness="0,2,0,0">
                                    <TextBlock x:Name="txtTotalActual"
                                        Text="N+W+S"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontFamily="Resources/Fonts/#Geom"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="4" Background="#9b8fb0" 
                                        BorderBrush="DarkSlateBlue"
                                        BorderThickness="0,2,0,0"
                                        CornerRadius="0,0,5,0">
                                    <TextBlock x:Name="txtTotalUsedPercentage" Text="N+W+S"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Resources/Fonts/#Geom"/>
                                </Border>
                            </Grid>
                            
                            <!--Pie Chart-->
                            <Grid Grid.Column="0" Grid.Row="1">
                                <lvc:PieChart
                                    x:Name="SpendingChart"
                                    Background="Transparent">
                                    <lvc:PieChart.Series>
                                        <lvc:SeriesCollection>
                                            <lvc:XamlPieSeries
                                                x:Name="NeedsSeries"
                                                Values="500"
                                                Style="{StaticResource SpendingPieChartStyle}"
                                                Fill="#85baff"/>
                                            <lvc:XamlPieSeries
                                                x:Name="WantsSeries"
                                                Values="300"
                                                Style="{StaticResource SpendingPieChartStyle}"
                                                Fill="#2f4a9c"/>
                                            <lvc:XamlPieSeries
                                                x:Name="SavingsSeries"
                                                Values="200"
                                                Style="{StaticResource SpendingPieChartStyle}"
                                                Fill="#1b2047"/>
                                        </lvc:SeriesCollection>
                                    </lvc:PieChart.Series>
                                </lvc:PieChart>
                            </Grid>
                        </Grid>
                        
                        <!--Transactions view-->
                        <Grid x:Name="transactionsView" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <GroupBox Header="Add New Transaction" Grid.Row="0"
                                       Margin="10"
                                      Foreground="AliceBlue" 
                                      Style="{StaticResource GenericGroupBox}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    
                                    <StackPanel Orientation="Horizontal" Grid.Row="0">
                                        <TextBlock Text="Transaction Name: " VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtName" Text="Add name" Margin="5,0,5,0" Height="25" Width="100"/>
                                        <TextBlock Text="Date: " VerticalAlignment="Center"/>
                                        <DatePicker x:Name="dpDate" Margin="5,0,5,0" Width="110"/>
                                        <TextBlock Text="Amount: " VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtAmount" Text="0.00" Margin="5,0,5,0" Width="100"/>
                                        <TextBlock Text="Category: " VerticalAlignment="Center"/>
                                        <ComboBox x:Name="cmbCategory"
                                                  Style="{StaticResource RoundedComboBoxStyle}"
                                                  ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                                  Margin="5,0,5,0" Width="100"
                                                  FontFamily="Resources/Fonts/#Lexend">
                                            <ComboBoxItem Content="Bills" IsSelected="True"/>
                                            <ComboBoxItem Content="Transport"/>
                                            <ComboBoxItem Content="Food"/>
                                            <ComboBoxItem Content="Shopping"/>
                                            <ComboBoxItem Content="Other"/>
                                        </ComboBox>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="10">
                                        <Button x:Name="BtnAddClick" Content="Add Transaction" Padding="5,0" 
                                                Style="{StaticResource GenericBtn}" FontFamily="Resources/Fonts/#Lexend"
                                                Click="BtnAdd_Click"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="Transactions" Grid.Row="1"
                                      Margin="10"
                                      Foreground="AliceBlue"
                                      FontFamily="Resources/Fonts/#Lexend"
                                      Style="{StaticResource GenericGroupBox}">
                                <DataGrid x:Name="dgTransactions"
                                          AutoGenerateColumns="False"
                                          GridLinesVisibility="Horizontal"
                                          Style="{DynamicResource TransactionsStyle}"
                                          FontFamily="Resources/Fonts/#Lexend"
                                          CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120"/>
                                        <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat='${0:F2}'}" Width="100"/>
                                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="120"/>
                                    </DataGrid.Columns>
                                    
                                </DataGrid>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>    
        </Grid>
        </Grid>
    </Border>
</Window>
