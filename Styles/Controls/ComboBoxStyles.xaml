<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Generic Combo box style -->
    
    <Style x:Key="GenericItemStyle" TargetType="ComboBoxItem">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontFamily" Value="./../../Resources/Fonts/#Geom"/>
        <Setter Property="Foreground" Value="#31223d"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Background="Transparent"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#F1ECE7"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#d7c8d9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="GenericFormComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Foreground" Value="#31223d"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource GenericItemStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="FormBox" Background="#F3EEE8" BorderBrush="#D9D3CC" BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Text}"
                                           Margin="10,0" VerticalAlignment="Center"
                                           Foreground="#9a95a0" Visibility="Collapsed" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <!-- The selected category text -->
                        <ContentPresenter Margin="12,0,28,0"
                                      VerticalAlignment="Center" HorizontalAlignment="Left"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      IsHitTestVisible="False"/>

                        <!-- Small arrow -->
                        <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{TemplateBinding Foreground}"
                          StrokeThickness="1.5" HorizontalAlignment="Right"
                          VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>

                        <!-- Invisible button covering the pill: clicking it opens the list -->
                        <ToggleButton Opacity="0" Focusable="False" ClickMode="Press"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}"/>

                        <!-- The dropdown list -->
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                           AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                Margin="0,4,0,0" Padding="4"
                                Background="#E8E2DC" CornerRadius="10">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                <ControlTemplate.Triggers>
                    <!-- While open or focused, the pill turns neutral -->
                    <Trigger Property="IsDropDownOpen" Value="True">
                        <Setter TargetName="FormBox" Property="Background" Value="#F1ECE7"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>
    
    <!-- Category in data table style -->
    
    <Style x:Key="CategoryItemStyle" TargetType="ComboBoxItem">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="#31223d"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Background="Transparent"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#F1ECE7"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#d7c8d9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="CategoryComboBoxStyle" TargetType="ComboBox">
    <Setter Property="Foreground" Value="#31223d"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="MinWidth" Value="110"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource CategoryItemStyle}"/>
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="ComboBox">
                <Grid>
                    <!-- The pill. Its color comes from the Background set on the ComboBox -->
                    <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="15"/>

                    <!-- The selected category text -->
                    <ContentPresenter Margin="12,0,28,0"
                                      VerticalAlignment="Center" HorizontalAlignment="Left"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      IsHitTestVisible="False"/>

                    <!-- Small arrow -->
                    <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{TemplateBinding Foreground}"
                          StrokeThickness="1.5" HorizontalAlignment="Right"
                          VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>

                    <!-- Invisible button covering the pill: clicking it opens the list -->
                    <ToggleButton Opacity="0" Focusable="False" ClickMode="Press"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}"/>

                    <!-- The dropdown list -->
                    <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                           AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                        <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                Margin="0,4,0,0" Padding="4"
                                Background="#E8E2DC" CornerRadius="10">
                            <ScrollViewer>
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>

                <ControlTemplate.Triggers>
                    <!-- While open or focused, the pill turns neutral -->
                    <Trigger Property="IsDropDownOpen" Value="True">
                        <Setter TargetName="Pill" Property="Background" Value="#F1ECE7"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>
</ResourceDictionary>