<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Column header ===== -->
    <Style x:Key="TransactionHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#D5D1CB"/>
        <Setter Property="Foreground" Value="#393647"/>
        <Setter Property="FontFamily" Value="./../../Resources/Fonts/#Geom"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ===== Cell ===== -->
    <Style x:Key="TransactionCellStyle" TargetType="DataGridCell">
        <Setter Property="Padding" Value="5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#393647"/>
        <Setter Property="FontFamily" Value="./../../Resources/Fonts/#Geom"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#d7c8d9"/>
                <Setter Property="Foreground" Value="#31223d"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Row ===== -->
    <Style x:Key="TransactionRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="MinHeight" Value="25"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F1ECE7"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== The DataGrid itself ===== -->
    <Style x:Key="TransactionsStyle" TargetType="DataGrid">
        <Setter Property="Foreground" Value="#1d1e21"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#aaa5ae"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource TransactionHeaderStyle}"/>
        <Setter Property="RowStyle" Value="{StaticResource TransactionRowStyle}"/>
        <Setter Property="CellStyle" Value="{StaticResource TransactionCellStyle}"/>
    </Style>
</ResourceDictionary>