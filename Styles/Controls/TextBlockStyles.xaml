<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--Generic Text-->
    <Style x:Key="GeneralText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#393647"/>
        <Setter Property="FontFamily" Value="./../../Resources/Fonts/#Geom"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Margin" Value="8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    
    <!-- Month Title Text-->
    <Style x:Key="MonthTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="./../../Resources/Fonts/#Lora"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0, 0" EndPoint="1, 1">
                    <GradientStop Color="CornflowerBlue" Offset="0"/>
                    <GradientStop Color="#8460b3" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--Budget Table-->
    <Style x:Key="BudgetTableTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="./../../Resources/Fonts/#Geom"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="#393647"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="30, 0 , 0, 0"/>
    </Style>
    
    <Style x:Key="BudgetTableSecondaryTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="./../../Resources/Fonts/#Geom"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#393647"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    
    <Style x:Key="BudgetTableStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="./../../Resources/Fonts/#Geom"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#393647"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    
</ResourceDictionary>