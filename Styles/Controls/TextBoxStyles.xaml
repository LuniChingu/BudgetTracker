<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Generic TextBox Style -->
    <Style x:Key="GenericField" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="AliceBlue"/>
        <Setter Property="BorderThickness" Value="0, 0, 0, 2"/>
        <Setter Property="BorderBrush" Value="DarkSlateBlue"/>
        <Setter Property="TextAlignment" Value="Left"/>
    </Style>
    
    <!-- Budget Table Field -->
    <Style x:Key="BudgetTableFieldStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="./../../Resources/Fonts/#Geom"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#393647"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
</ResourceDictionary>
