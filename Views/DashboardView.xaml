<UserControl x:Class="BudgetTracker.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sharp="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="*" d:DesignWidth="*"
             Background="#1f1f24">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="425"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
                            
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="255"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" Grid.Column="0">
            <TextBlock Text="Quick Look"
                       FontFamily="Resources/Fonts/#Geom"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="AliceBlue"
                       VerticalAlignment="Bottom"
                       Margin="30, 0, 0, 0"/>
        </Grid>
        
        <!--Budget Table-->
        <Grid Grid.Row="1" Grid.Column="0" Margin="10,16,10,10">
                            
            <Grid.RowDefinitions>
                <RowDefinition Height="37"/> <!--Table Header Row-->
                <RowDefinition Height="37"/> <!--Income row-->
                <RowDefinition Height="37"/> <!--Needs row-->
                <RowDefinition Height="37"/> <!--Wants row-->
                <RowDefinition Height="37"/> <!--Savings row-->
                <RowDefinition Height="37"/> <!--total row-->
            </Grid.RowDefinitions>
                            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="75"/>
            </Grid.ColumnDefinitions>
                            
            <!--Header Row Titles-->
            <Border Grid.Row="0" Grid.Column="0" BorderThickness="1" 
                    BorderBrush="CornflowerBlue" 
                    CornerRadius="5,0,0,0">
                <TextBlock Text="CATEGORY"
                           Style="{StaticResource BudgetTableTitle}"/>
            </Border>
            <Border Grid.Row="0" Grid.Column="1" BorderThickness="0, 1, 1, 1" 
                    BorderBrush="CornflowerBlue">
                <TextBlock Text="Goal"
                           Style="{StaticResource BudgetTableTitle}"/>
            </Border>
            <Border Grid.Row="0" Grid.Column="2" BorderThickness="0, 1, 1, 1" 
                    BorderBrush="CornflowerBlue" >
                <TextBlock Text="Plan"
                           Style="{StaticResource BudgetTableTitle}"/>
            </Border>
            <Border Grid.Row="0" Grid.Column="3" BorderThickness="0, 1, 1, 1" 
                    BorderBrush="CornflowerBlue">
                <TextBlock Text="Actual"
                           Style="{StaticResource BudgetTableTitle}"/>
            </Border>
            <Border Grid.Row="0" Grid.Column="4" BorderThickness="0, 1, 1, 1" 
                    BorderBrush="CornflowerBlue"
                    CornerRadius="0,5,0,0">
                <TextBlock Text="Budget"
                           Style="{StaticResource BudgetTableTitle}"/>
            </Border>
                            
            <!--Income Row-->
            <Border Grid.Row="1" Grid.Column="0" Background="MediumPurple" 
                    BorderBrush="Lavender" BorderThickness="0,0,1,0">
                <TextBlock Text="INCOME" 
                           Style="{StaticResource BudgetTableTitle}"/>
            </Border>
            <Border Grid.Row="1" Grid.Column="1" Background="MediumPurple" 
                    BorderBrush="Lavender" BorderThickness="0,0,1,0">
                <TextBox Text="{Binding IncomeGoal, UpdateSourceTrigger=LostFocus}"
                         HorizontalAlignment="Center" 
                         VerticalAlignment="Center"
                         Background="Transparent"
                         FontFamily="Resources/Fonts/#Geom"
                         FontWeight="SemiBold"
                         Foreground="AliceBlue"
                         BorderThickness="0"/>
            </Border>
            <Border Grid.Row="1" Grid.Column="2" Background="MediumPurple" 
                    BorderBrush="Lavender" BorderThickness="0,0,1,0">
                <TextBlock Text="user input" 
                           Style="{StaticResource BudgetTableStyle}"/>
            </Border>
            <Border Grid.Row="1" Grid.Column="3" Background="MediumPurple" 
                    BorderBrush="Lavender" BorderThickness="0,0,1,0">
                <TextBlock Text="user input"
                           Style="{StaticResource BudgetTableStyle}"/>
            </Border>
            <Border Grid.Row="1" Grid.Column="4" Background="MediumPurple" 
                    BorderBrush="Lavender">
                <TextBlock Text="100%"
                           Style="{StaticResource BudgetTableStyle}"/>
            </Border>
                            
            <!--Needs Row-->
            <Border Grid.Row="2" Grid.Column="0" BorderThickness="1,1,1,0"
                    Style="{StaticResource BudgetTableStrokeStyle}">
                <TextBlock Text="NEEDS"
                           Style="{StaticResource BudgetTableTitle}"/>
            </Border>
            <Border Grid.Row="2" Grid.Column="1"
                    BorderThickness="0,1,1,0"
                    Style="{StaticResource BudgetTableStrokeStyle}">
                <TextBlock Text="{Binding NeedsGoal, StringFormat=F2}"
                           d:Text="500.00"
                           Style="{StaticResource BudgetTableStyle}"/>
            </Border>
            <Border Grid.Row="2" Grid.Column="2" BorderThickness="0,1,1,0"
                    Style="{StaticResource BudgetTableStrokeStyle}">
                <TextBlock Text="0.00"
                           Style="{StaticResource BudgetTableStyle}"/>
            </Border>
            <Border Grid.Row="2" Grid.Column="3" BorderThickness="0,1,1,0"
                    Style="{StaticResource BudgetTableStrokeStyle}">
                <TextBlock Text="calculated"
                           Style="{StaticResource BudgetTableStyle}"/>
            </Border>
            <Border Grid.Row="2" Grid.Column="4" BorderThickness="0,1,1,0"
                    Style="{StaticResource BudgetTableStrokeStyle}">
                <TextBlock Text="{Binding NeedsPercent, StringFormat=P0}"
                           Style="{StaticResource BudgetTableStyle}"/>
            </Border>
                            
            <!--Wants Row-->
            <Border Grid.Row="3" Grid.Column="0" BorderThickness="1,1,1,0"
                    Style="{StaticResource BudgetTableStrokeStyle}">
                <TextBlock Text="WANTS"
                           Style="{StaticResource BudgetTableTitle}"/>
            </Border>
            <Border Grid.Row="3" Grid.Column="1" BorderThickness="0,1,1,0"
                    Style="{StaticResource BudgetTableStrokeStyle}">
                <TextBlock Text="{Binding WantsGoal, StringFormat=F2}"
                           Style="{StaticResource BudgetTableStyle}"/>
            </Border>
            <Border Grid.Row="3" Grid.Column="2" BorderThickness="0,1,1,0"
                    Style="{StaticResource BudgetTableStrokeStyle}">
                <TextBlock Text="0.00"
                           Style="{StaticResource BudgetTableStyle}"/>
            </Border>
            <Border Grid.Row="3" Grid.Column="3" BorderThickness="0,1,1,0"
                    Style="{StaticResource BudgetTableStrokeStyle}">
                <TextBlock Text="calculated"
                           Style="{StaticResource BudgetTableStyle}"/>
            </Border>
            <Border Grid.Row="3" Grid.Column="4" BorderThickness="0,1,1,0"
                    Style="{StaticResource BudgetTableStrokeStyle}">
                <TextBlock Text="{Binding WantsPercent, StringFormat=P0}"
                           Style="{StaticResource BudgetTableStyle}"/>
            </Border>
                            
            <!--Savings Row-->
            <Border Grid.Row="4" Grid.Column="0" BorderThickness="1,1,1,0"
                    Style="{StaticResource BudgetTableStrokeStyle}">
                <TextBlock Text="SAVINGS"
                           Style="{StaticResource BudgetTableTitle}"/>
            </Border>
            <Border Grid.Row="4" Grid.Column="1" BorderThickness="0,1,1,0"
                    Style="{StaticResource BudgetTableStrokeStyle}">
                <TextBlock Text="{Binding SavingsGoal, StringFormat=F2}"
                           Style="{StaticResource BudgetTableStyle}"/>
            </Border>
            <Border Grid.Row="4" Grid.Column="2" BorderThickness="0,1,1,0"
                    Style="{StaticResource BudgetTableStrokeStyle}">
                <TextBlock Text="0.00"
                           Style="{StaticResource BudgetTableStyle}"/>
            </Border>
            <Border Grid.Row="4" Grid.Column="3" BorderThickness="0,1,1,0"
                    Style="{StaticResource BudgetTableStrokeStyle}">
                <TextBlock Text="calculated"
                           Style="{StaticResource BudgetTableStyle}"/>
            </Border>
            <Border Grid.Row="4" Grid.Column="4" BorderThickness="0,1,1,0"
                    Style="{StaticResource BudgetTableStrokeStyle}">
                <TextBlock Text="{Binding SavingsPercent, StringFormat=P0}"
                           Style="{StaticResource BudgetTableStyle}"/>
            </Border>
                            
            <!--Total Row-->
            <Border Grid.Row="5" Grid.Column="0" Background="#9b8fb0" 
                    BorderBrush="DarkSlateBlue"
                    BorderThickness="0,2,0,0"
                    CornerRadius="0,0,0,5">
                <TextBlock Text="TOTAL" 
                           Style="{StaticResource BudgetTableTitle}"/>
            </Border>
            <Border Grid.Row="5" Grid.Column="1" Background="#9b8fb0" 
                    BorderBrush="DarkSlateBlue"
                    BorderThickness="0,2,0,0">
                <TextBlock Text="{Binding TotalGoal, StringFormat=F2}"
                           Style="{StaticResource BudgetTableStyle}"/>
            </Border>
            <Border Grid.Row="5" Grid.Column="2" Background="#9b8fb0" 
                    BorderBrush="DarkSlateBlue"
                    BorderThickness="0,2,0,0">
                <TextBlock Text="0.00"
                           Style="{StaticResource BudgetTableStyle}"/>
            </Border>
            <Border Grid.Row="5" Grid.Column="3" Background="#9b8fb0" 
                    BorderBrush="DarkSlateBlue"
                    BorderThickness="0,2,0,0">
                <TextBlock Text="N+W+S"
                           Style="{StaticResource BudgetTableStyle}"/>
            </Border>
            <Border Grid.Row="5" Grid.Column="4" Background="#9b8fb0" 
                    BorderBrush="DarkSlateBlue"
                    BorderThickness="0,2,0,0"
                    CornerRadius="0,0,5,0">
                <TextBlock Text="{Binding TotalPercent, StringFormat=P0}"
                           Style="{StaticResource BudgetTableStyle}"/>
            </Border>
        </Grid>
        
        <!-- Category view tentative -->
        <Grid Grid.Row="0" Grid.Column="1">
            <TextBlock Text="Breakdown by Category"
                       FontFamily="Resources/Fonts/#Geom"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="AliceBlue"
                       VerticalAlignment="Bottom"
                       Margin="10, 0, 10, 0"/>
        </Grid>
        
        <Border Grid.Row="1" Grid.Column="1"
                  Margin="10"
                  BorderBrush="CornflowerBlue"
                  BorderThickness="1"
                  CornerRadius="10"
                  Width="250">
           <Grid>
               <Grid.ColumnDefinitions>
                   <ColumnDefinition Width="Auto"/>
                   <ColumnDefinition Width="97"/>
                   <ColumnDefinition Width="*"/>
               </Grid.ColumnDefinitions>
               
               <StackPanel Grid.Column="0" Orientation="Vertical">
                   <sharp:IconImage Icon="Burger"
                                    Foreground="AliceBlue"
                                    Style="{StaticResource CategoryIcon}"/>
                   <sharp:IconImage Icon="SuitcaseRolling"
                                    Foreground="AliceBlue"
                                    Style="{StaticResource CategoryIcon}"/>
                   <sharp:IconImage Icon="BuildingColumns"
                                    Foreground="AliceBlue"
                                    Style="{StaticResource CategoryIcon}"/>
                   <sharp:IconImage Icon="Ticket"
                                    Foreground="AliceBlue"
                                    Style="{StaticResource CategoryIcon}"/>
                   <sharp:IconImage Icon="CarSide"
                                    Foreground="AliceBlue"
                                    Style="{StaticResource CategoryIcon}"/>
                   <sharp:IconImage Icon="Lightbulb"
                                    Foreground="AliceBlue"
                                    Style="{StaticResource CategoryIcon}"/>
                   <sharp:IconImage Icon="ShoppingBasket"
                                    Foreground="AliceBlue"
                                    Style="{StaticResource CategoryIcon}"/>
                   <sharp:IconImage Icon="Bolt"
                                    Foreground="AliceBlue"
                                    Style="{StaticResource CategoryIcon}"/>
                   <sharp:IconImage Icon="Tags"
                                    Foreground="AliceBlue"
                                    Style="{StaticResource CategoryIcon}"/>
               </StackPanel>
               
               <StackPanel Grid.Column="1" Height="220">
                   <TextBlock Text="Takeout" Margin="0, 2, 0, 0"
                              Style="{StaticResource GeneralText}"/>
                   <TextBlock Text="Travel" Margin="0, 9, 0, 0"
                              Style="{StaticResource GeneralText}"/>
                   <TextBlock Text="Essentials" Margin="0, 9, 0, 0"
                              Style="{StaticResource GeneralText}"/>
                   <TextBlock Text="Entertainment" Margin="0, 9, 0, 0"
                              Style="{StaticResource GeneralText}"/>
                   <TextBlock Text="Transport" Margin="0, 9, 0, 0"
                              Style="{StaticResource GeneralText}"/>
                   <TextBlock Text="Housing" Margin="0, 9, 0, 0"
                              Style="{StaticResource GeneralText}"/>
                   <TextBlock Text="Groceries" Margin="0, 9, 0, 0"
                              Style="{StaticResource GeneralText}"/>
                   <TextBlock Text="Electronics" Margin="0, 9, 0, 0"
                              Style="{StaticResource GeneralText}"/>
                   <TextBlock Text="Misc" Margin="0, 8, 0, 0"
                              Style="{StaticResource GeneralText}"/>
               </StackPanel>
               
               <StackPanel Grid.Column="2">
                   <ProgressBar Value="50" Maximum="100" Margin="0,10,5,6"
                                Style="{StaticResource RoundedLinearProgressBarStyle}"/>
                   <ProgressBar Value="50" Maximum="100"
                                Style="{StaticResource RoundedLinearProgressBarStyle}"/>
                   <ProgressBar Value="50" Maximum="100" 
                                Style="{StaticResource RoundedLinearProgressBarStyle}"/>
                   <ProgressBar Value="50" Maximum="100"
                                Style="{StaticResource RoundedLinearProgressBarStyle}"/>
                   <ProgressBar Value="50" Maximum="100"
                                Style="{StaticResource RoundedLinearProgressBarStyle}"/>
                   <ProgressBar Value="50" Maximum="100" Minimum="0"
                                Style="{StaticResource RoundedLinearProgressBarStyle}"/>
                   <ProgressBar Value="50" Maximum="100"
                                Style="{StaticResource RoundedLinearProgressBarStyle}"/>
                   <ProgressBar Value="50" Maximum="100"
                                Style="{StaticResource RoundedLinearProgressBarStyle}"/>
                   <ProgressBar Value="50" Maximum="100"
                                Style="{StaticResource RoundedLinearProgressBarStyle}"/>
               </StackPanel>
               
           </Grid>
            
        </Border>
        
        <!--Pie Chart-->
        <Grid Grid.Column="0" Grid.Row="2">
            <lvc:PieChart Series="{Binding BudgetTrendSeries}"
                Background="Transparent"/>
        </Grid>
    </Grid>
</UserControl>
