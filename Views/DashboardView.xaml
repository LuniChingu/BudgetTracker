<UserControl x:Class="BudgetTracker.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="*" d:DesignWidth="*"
             Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="530"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
                            
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Column="0" Grid.Row="0"
                Background="#E8E2DC"
                CornerRadius="10"
                Margin="10"
                Padding="15"
                VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Quick Look"
                               FontFamily="Resources/Fonts/#Geom"
                               FontSize="20"
                               FontWeight="Medium"
                               Foreground="#31223d"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,8"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource MonthNavButtonStyle}"
                                Command="{Binding PreviousMonthCommand}">
                            <fa:IconImage Grid.Row="0" Grid.Column="0" Icon="AngleLeft"
                                             Style="{StaticResource NavigationIcon}"/>
                        </Button>
                        <TextBlock Text="{Binding SelectedMonth, StringFormat='MMMM yyyy'}"
                                   FontFamily="Resources/Fonts/#Geom"
                                   FontSize="16"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   Foreground="#31223d"
                                   Margin="5"/>
                        <Button Style="{StaticResource MonthNavButtonStyle}"
                                Command="{Binding NextMonthCommand}">
                            <fa:IconImage Grid.Row="0" Grid.Column="0" Icon="AngleRight"
                                             Style="{StaticResource NavigationIcon}"/>
                        </Button>
                    </StackPanel>
                </Grid>
        <!--Budget Table-->
            <Grid Grid.Row="1">
                            
                <Grid.RowDefinitions>
                    <RowDefinition Height="37"/> <!--Table Header Row-->
                    <RowDefinition Height="37"/> <!--Income row-->
                    <RowDefinition Height="37"/> <!--Needs row-->
                    <RowDefinition Height="37"/> <!--Wants row-->
                    <RowDefinition Height="37"/> <!--Savings row-->
                    <RowDefinition Height="37"/> <!--total row-->
                </Grid.RowDefinitions>
                            
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                            
            <!--Header Row Titles-->
                <Border Grid.Row="0" Grid.Column="0" 
                    Background="LightGray"
                    CornerRadius="5,0,0,0">
                    <TextBlock Text="CATEGORY"
                           Style="{StaticResource BudgetTableSecondaryTitle}"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" BorderThickness="1, 0, 0, 0" 
                    BorderBrush="#aaa5ae"
                    Background="LightGray">
                    <TextBlock Text="GOAL"
                           Style="{StaticResource BudgetTableSecondaryTitle}"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" BorderThickness="1, 0, 0, 0"
                        BorderBrush="#aaa5ae"
                        Background="LightGray">
                        <TextBlock Text="PLAN"
                                Style="{StaticResource BudgetTableSecondaryTitle}"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="3" BorderThickness="1, 0, 0, 0"
                        BorderBrush="#aaa5ae"
                        Background="LightGray">
                    <TextBlock Text="ACTUAL"
                           Style="{StaticResource BudgetTableSecondaryTitle}"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="4" BorderThickness="1, 0, 0, 0" 
                        BorderBrush="#aaa5ae"
                        Background="LightGray"
                    CornerRadius="0,5,0,0">
                    <TextBlock Text="BUDGET"
                           Style="{StaticResource BudgetTableSecondaryTitle}"/>
                </Border>
                            
            <!--Income Row-->
                <Border Grid.Row="1" Grid.Column="0" Background="#d7c8d9">
                        <TextBlock Text="INCOME" 
                            Style="{StaticResource BudgetTableTitle}"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Background="#d7c8d9"
                    BorderBrush="#aaa5ae" BorderThickness="1,0,0,0">
                    <TextBox Text="{Binding IncomeGoal, StringFormat=F2 , UpdateSourceTrigger=LostFocus}"
                             Style="{StaticResource BudgetTableFieldStyle}"
                             Height="Auto"
                             Width="Auto"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Background="#d7c8d9" 
                        BorderBrush="#aaa5ae" BorderThickness="1,0,0,0">
                    <TextBox Text="{Binding IncomePlan, StringFormat=F2 , UpdateSourceTrigger=LostFocus}" 
                           Style="{StaticResource BudgetTableFieldStyle}"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="3" Background="#d7c8d9" 
                        BorderBrush="#aaa5ae" BorderThickness="1,0,0,0">
                    <TextBox Text="{Binding IncomeActual, StringFormat=F2 , UpdateSourceTrigger=LostFocus}"
                           Style="{StaticResource BudgetTableFieldStyle}"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="4" Background="#d7c8d9" 
                        BorderBrush="#aaa5ae" BorderThickness="1,0,0,0">
                    <TextBlock Text="100%"
                           Style="{StaticResource BudgetTableStyle}"/>
                </Border>
                            
            <!--Needs Row-->
                <Border Grid.Row="2" Grid.Column="0"
                    Style="{StaticResource BudgetTableStrokeStyle}">
                        <TextBlock Text="NEEDS"
                                Style="{StaticResource BudgetTableTitle}"/>
                </Border>
                <Border Grid.Row="2" Grid.Column="1"
                            BorderBrush="#aaa5ae" BorderThickness="1,0,0,0"
                            Style="{StaticResource BudgetTableStrokeStyle}">
                        <TextBlock Text="{Binding NeedsGoal, StringFormat=F2}"
                                d:Text="500.00"
                                Style="{StaticResource BudgetTableStyle}"/>
                </Border>
                <Border Grid.Row="2" Grid.Column="2" 
                            BorderBrush="#aaa5ae" BorderThickness="1,0,0,0"
                            Style="{StaticResource BudgetTableStrokeStyle}">
                        <TextBlock Text="0.00"
                                Style="{StaticResource BudgetTableStyle}"/>
                </Border>
                <Border Grid.Row="2" Grid.Column="3" 
                            BorderBrush="#aaa5ae" BorderThickness="1,0,0,0"
                            Style="{StaticResource BudgetTableStrokeStyle}">
                        <TextBlock Text="{Binding NeedsActual, StringFormat=F2}"
                                Style="{StaticResource BudgetTableStyle}"/>
                </Border>
                <Border Grid.Row="2" Grid.Column="4" 
                            BorderBrush="#aaa5ae" BorderThickness="1,0,0,0"
                            Style="{StaticResource BudgetTableStrokeStyle}">
                        <TextBlock Text="{Binding NeedsPercent, StringFormat=P1}"
                                Style="{StaticResource BudgetTableStyle}"/>
                </Border>
                            
            <!--Wants Row-->
                <Border Grid.Row="3" Grid.Column="0"
                        BorderBrush="#aaa5ae" BorderThickness="0,1,0,0"
                        Style="{StaticResource BudgetTableStrokeStyle}">
                            <TextBlock Text="WANTS"
                                       Style="{StaticResource BudgetTableTitle}"/>
                </Border>
                <Border Grid.Row="3" Grid.Column="1"
                        BorderBrush="#aaa5ae" BorderThickness="1,1,0,0"
                        Style="{StaticResource BudgetTableStrokeStyle}">
                            <TextBlock Text="{Binding WantsGoal, StringFormat=F2}"
                                       Style="{StaticResource BudgetTableStyle}"/>
                </Border>
                <Border Grid.Row="3" Grid.Column="2"
                        BorderBrush="#aaa5ae" BorderThickness="1,1,0,0"
                        Style="{StaticResource BudgetTableStrokeStyle}">
                            <TextBlock Text="0.00"
                                       Style="{StaticResource BudgetTableStyle}"/>
                </Border>
                <Border Grid.Row="3" Grid.Column="3"
                        BorderBrush="#aaa5ae" BorderThickness="1,1,0,0"
                        Style="{StaticResource BudgetTableStrokeStyle}">
                            <TextBlock Text="{Binding WantsActual, StringFormat=F2}"
                                       Style="{StaticResource BudgetTableStyle}"/>
                </Border>
                <Border Grid.Row="3" Grid.Column="4"
                        BorderBrush="#aaa5ae" BorderThickness="1,1,0,0"
                        Style="{StaticResource BudgetTableStrokeStyle}">
                            <TextBlock Text="{Binding WantsPercent, StringFormat=P1}"
                                       Style="{StaticResource BudgetTableStyle}"/>
                </Border>
                            
            <!--Savings Row-->
                <Border Grid.Row="4" Grid.Column="0"
                        BorderBrush="#aaa5ae" BorderThickness="0,1,0,0"
                        Style="{StaticResource BudgetTableStrokeStyle}">
                            <TextBlock Text="SAVINGS"
                                       Style="{StaticResource BudgetTableTitle}"/>
                </Border>
                <Border Grid.Row="4" Grid.Column="1"
                        BorderBrush="#aaa5ae" BorderThickness="1,1,0,0"
                        Style="{StaticResource BudgetTableStrokeStyle}">
                            <TextBlock Text="{Binding SavingsGoal, StringFormat=F2}"
                                       Style="{StaticResource BudgetTableStyle}"/>
                </Border>
                <Border Grid.Row="4" Grid.Column="2"
                        BorderBrush="#aaa5ae" BorderThickness="1,1,0,0"
                        Style="{StaticResource BudgetTableStrokeStyle}">
                            <TextBlock Text="0.00"
                                       Style="{StaticResource BudgetTableStyle}"/>
                </Border>
                <Border Grid.Row="4" Grid.Column="3" 
                        BorderBrush="#aaa5ae" BorderThickness="1,1,0,0"
                        Style="{StaticResource BudgetTableStrokeStyle}">
                            <TextBlock Text="{Binding SavingsActual, StringFormat=F2}"
                                       Style="{StaticResource BudgetTableStyle}"/>
                </Border>
                <Border Grid.Row="4" Grid.Column="4"
                        BorderBrush="#aaa5ae" BorderThickness="1,1,0,0"
                        Style="{StaticResource BudgetTableStrokeStyle}">
                            <TextBlock Text="{Binding SavingsPercent, StringFormat=P1}"
                                       Style="{StaticResource BudgetTableStyle}"/>
                </Border>
                            
            <!--Total Row-->
                <Border Grid.Row="5" Grid.Column="0" Background="#8c7697" 
                    CornerRadius="0,0,0,5">
                    <TextBlock Text="TOTAL" 
                           Style="{StaticResource BudgetTableTitle}"/>
                </Border>
                <Border Grid.Row="5" Grid.Column="1" Background="#8c7697"
                        BorderBrush="#aaa5ae" BorderThickness="1,0,0,0">
                    <TextBlock Text="{Binding TotalGoal, StringFormat=F2}"
                           Style="{StaticResource BudgetTableStyle}"/>
                </Border>
                <Border Grid.Row="5" Grid.Column="2" Background="#8c7697"
                        BorderBrush="#aaa5ae" BorderThickness="1,0,0,0">
                    <TextBlock Text="0.00"
                           Style="{StaticResource BudgetTableStyle}"/>
                </Border>
                <Border Grid.Row="5" Grid.Column="3" Background="#8c7697"
                        BorderBrush="#aaa5ae" BorderThickness="1,0,0,0">
                    <TextBlock Text="{Binding TotalActual, StringFormat=F2}"
                           Style="{StaticResource BudgetTableStyle}"/>
                </Border>
                <Border Grid.Row="5" Grid.Column="4" Background="#8c7697"
                        BorderBrush="#aaa5ae" BorderThickness="1,0,0,0"
                    CornerRadius="0,0,5,0">
                    <TextBlock Text="{Binding TotalPercent, StringFormat=P1}"
                           Style="{StaticResource BudgetTableStyle}"/>
                </Border>
            </Grid>
            </Grid>
        </Border>
        <!-- Category view tentative -->
        <Border Grid.Row="0" Grid.Column="1"
                Background="#E8E2DC"
                CornerRadius="10"
                Margin="5,10, 10, 10"
                Padding="15, 10, 15, 5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                    <TextBlock Grid.Row="0" Text="Breakdown by Category"
                               FontFamily="Resources/Fonts/#Geom"
                               FontSize="16"
                               FontWeight="Medium"
                               Foreground="#31223d"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,8"/>
            
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
               
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                    </Grid.RowDefinitions>
                    
                    <fa:IconImage Grid.Row="0" Grid.Column="0" Icon="Utensils"
                                     Style="{StaticResource CategoryIcon}"/>
                    <fa:IconImage Grid.Row="1" Grid.Column="0" Icon="SuitcaseRolling"
                                  Style="{StaticResource CategoryIcon}"/>
                    <fa:IconImage Grid.Row="2" Grid.Column="0" Icon="BuildingColumns"
                                  Style="{StaticResource CategoryIcon}"/>
                    <fa:IconImage Grid.Row="3" Grid.Column="0" Icon="Gamepad"
                                  Style="{StaticResource CategoryIcon}"/>
                    <fa:IconImage Grid.Row="4" Grid.Column="0" Icon="CarSide"
                                  Style="{StaticResource CategoryIcon}"/>
                    <fa:IconImage Grid.Row="5" Grid.Column="0" Icon="HouseChimney"
                                  Style="{StaticResource CategoryIcon}"/>
                    <fa:IconImage Grid.Row="6" Grid.Column="0" Icon="CartShopping"
                                  Style="{StaticResource CategoryIcon}"/>
                    <fa:IconImage Grid.Row="7" Grid.Column="0" Icon="Laptop"
                                  Style="{StaticResource CategoryIcon}"/>
                    <fa:IconImage Grid.Row="8" Grid.Column="0" Icon="Tags"
                                  Style="{StaticResource CategoryIcon}"/>
                    
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Takeout"
                               Style="{StaticResource GeneralText}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Travel"
                               Style="{StaticResource GeneralText}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Essentials"
                               Style="{StaticResource GeneralText}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Entertainment"
                               Style="{StaticResource GeneralText}"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Transport"
                               Style="{StaticResource GeneralText}"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="Housing"
                               Style="{StaticResource GeneralText}"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="Groceries"
                               Style="{StaticResource GeneralText}"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="Electronics"
                               Style="{StaticResource GeneralText}"/>
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="Misc"
                               Style="{StaticResource GeneralText}"/>
                    
                    <ProgressBar Grid.Row="0" Grid.Column="3" Value="50" Maximum="100" Margin="0,10,5,6"
                                 Style="{StaticResource RoundedLinearProgressBarStyle}"/>
                    <ProgressBar Grid.Row="1" Grid.Column="3" Value="50" Maximum="100"
                                 Style="{StaticResource RoundedLinearProgressBarStyle}"/>
                    <ProgressBar Grid.Row="2" Grid.Column="3" Value="50" Maximum="100" 
                                 Style="{StaticResource RoundedLinearProgressBarStyle}"/>
                    <ProgressBar Grid.Row="3" Grid.Column="3" Value="50" Maximum="100"
                                 Style="{StaticResource RoundedLinearProgressBarStyle}"/>
                    <ProgressBar Grid.Row="4" Grid.Column="3" Value="50" Maximum="100"
                                 Style="{StaticResource RoundedLinearProgressBarStyle}"/>
                    <ProgressBar Grid.Row="5" Grid.Column="3" Value="50" Maximum="100" Minimum="0"
                                 Style="{StaticResource RoundedLinearProgressBarStyle}"/>
                    <ProgressBar Grid.Row="6" Grid.Column="3" Value="50" Maximum="100"
                                 Style="{StaticResource RoundedLinearProgressBarStyle}"/>
                    <ProgressBar Grid.Row="7" Grid.Column="3" Value="50" Maximum="100"
                                 Style="{StaticResource RoundedLinearProgressBarStyle}"/>
                    <ProgressBar Grid.Row="8" Grid.Column="3" Value="50" Maximum="100"
                                 Style="{StaticResource RoundedLinearProgressBarStyle}"/>
                </Grid>
            </Grid>
        </Border>
        
        <!--Pie Chart-->
        <Grid Grid.Column="0" Grid.Row="1">
            
                <lvc:PieChart Series="{Binding BudgetTrendSeries}"
                              Background="Transparent"
                              LegendPosition="Right"/>
                <StackPanel Height="300" Margin="0, 205, 130, 0">
                    <TextBlock Text="{Binding TotalActual, StringFormat={}{0:C2}, ConverterCulture=he-IL}"
                               Foreground="#393647"
                               VerticalAlignment="Bottom"
                               HorizontalAlignment="Center"
                               FontFamily="Resources/Fonts/#Geom"
                               FontSize="32"
                               FontWeight="Bold"/>
                    <TextBlock Text="Total"
                               Foreground="#393647"
                               VerticalAlignment="Bottom"
                               HorizontalAlignment="Center"
                               FontFamily="Resources/Fonts/#Geom"
                               FontSize="24"
                               FontWeight="Normal"/>
                </StackPanel>
        </Grid>
        
        <!-- Bar Chart for 'most spent category' -->
    </Grid>
</UserControl>
