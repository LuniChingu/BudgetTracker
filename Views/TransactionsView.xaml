<UserControl x:Class="BudgetTracker.Views.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             mc:Ignorable="d"
             d:DesignHeight="*" d:DesignWidth="*"
             Background="Transparent">
    <Border Background="#E8E2DC" Margin="10"
            CornerRadius="20"
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Transactions"
                           FontFamily="Resources/Fonts/#Geom"
                           FontSize="32"
                           FontWeight="DemiBold"
                           Foreground="#31223d"
                           Margin="10"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource MonthNavButtonStyle}"
                            Command="{Binding PreviousMonthCommand}">
                        <fa:IconImage Grid.Row="0" Grid.Column="0" Icon="Plus"
                                         Style="{StaticResource ButtonIcon}"/>
                    </Button>
                    <Button Style="{StaticResource MonthNavButtonStyle}"
                            Command="{Binding PreviousMonthCommand}">
                        <fa:IconImage Grid.Row="0" Grid.Column="0" Icon="Filter"
                                      Style="{StaticResource ButtonIcon}"/>
                    </Button>
                    <Button Style="{StaticResource MonthNavButtonStyle}"
                            Command="{Binding PreviousMonthCommand}">
                        <fa:IconImage Grid.Row="0" Grid.Column="0" Icon="SquareCheck"
                                      Style="{StaticResource ButtonIcon}"/>
                    </Button>
                </StackPanel>
            </Grid>
        
            
                <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Transactions}"
                      AutoGenerateColumns="False"
                      GridLinesVisibility="Horizontal"
                      Style="{DynamicResource TransactionsStyle}"
                      FontFamily="Resources/Fonts/#Geom"
                      CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NAME" Binding="{Binding TransactionName}" Width="*"/>
                        <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120"/>
                        <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat='${0:F2}'}" Width="100"/>
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
        </Grid>
    </Border>
</UserControl>
