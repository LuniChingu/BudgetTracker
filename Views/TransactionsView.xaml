<UserControl x:Class="BudgetTracker.Views.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:conv="clr-namespace:BudgetTracker.Converters"
             xmlns:viewModels="clr-namespace:BudgetTracker.ViewModels"
             xmlns:models="clr-namespace:BudgetTracker.Models"
             d:DataContext="{d:DesignInstance Type=viewModels:TransactionsViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="*" d:DesignWidth="*"
             Background="Transparent">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:CategoryToBrushConverter x:Key="CategoryBrush"/>
    </UserControl.Resources>
    
    <Border Background="#E8E2DC" Margin="10"
            CornerRadius="20"
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="Transactions"
                           FontFamily="./../../Resources/Fonts/#Geom"
                           FontSize="32"
                           FontWeight="DemiBold"
                           Foreground="#31223d"
                           Margin="10"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Style="{StaticResource TransactionButtonStyle}"
                            Command="{Binding ToggleAddCommand}" 
                            ToolTip="Add transaction">
                        <fa:IconImage Grid.Row="0" Grid.Column="0" Icon="Plus"
                                         Style="{StaticResource ButtonIcon}"/>
                    </Button>
                    <Button Style="{StaticResource TransactionButtonStyle}"
                            Command="{Binding TBA}">
                        <fa:IconImage Grid.Row="0" Grid.Column="0" Icon="Calendar"
                                      Style="{StaticResource ButtonIcon}"/>
                    </Button>
                    <Button Style="{StaticResource TransactionButtonStyle}"
                            Command="{Binding TBA}">
                        <fa:IconImage Grid.Row="0" Grid.Column="0" Icon="Filter"
                                      Style="{StaticResource ButtonIcon}"/>
                    </Button>
                    <Button Style="{StaticResource TransactionButtonStyle}"
                            Command="{Binding TBA}">
                        <fa:IconImage Grid.Row="0" Grid.Column="0" Icon="SquareCheck"
                                      Style="{StaticResource ButtonIcon}"/>
                    </Button>
                </StackPanel>
            </Grid>
        
            <Border Grid.Row="1" Margin="10,0,10,10"
                    Visibility="{Binding IsAddOpen,
                    Converter={StaticResource BoolToVis}}"
                    Padding="15" BorderThickness="0.3"
                    BorderBrush="#393647"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0, 12, 8, 0">
                        <TextBlock Text="TRANSACTION NAME" FontSize="14"
                                   Margin="0,0,0,4"
                                   Style="{StaticResource GeneralText}"/>
                        <TextBox Style="{StaticResource FormTextBoxStyle}"
                                 Tag="e.g. Grocery shopping"
                                 Text="{Binding NewName, 
                                 UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8, 12, 0, 0">
                        <TextBlock Text="AMOUNT" FontSize="14"
                                   Margin="0,0,0,4"
                                   Style="{StaticResource GeneralText}"/>
                        <TextBox Style="{StaticResource FormTextBoxStyle}"
                                 Tag="₪0.00"
                                 Text="{Binding NewAmount, 
                                 UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0, 12, 8, 0">
                        <TextBlock Text="DATE" FontSize="14"
                                   Margin="0,0,0,4"
                                   Style="{StaticResource GeneralText}"/>
                        <DatePicker Margin="5,0,5,0" Width="110" 
                                    SelectedDate="{Binding NewDate}"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8, 12, 0, 0">
                        <TextBlock Text="CATEGORY" FontSize="14"
                                   Margin="0,0,0,4"
                                   Style="{StaticResource GeneralText}"/>
                        <ComboBox Style="{StaticResource GenericFormComboBoxStyle}"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Static models:Categories.All}"
                                  SelectedItem="{Binding NewCategory}"/>
                    </StackPanel>
                    
                    <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right"
                            Style="{StaticResource ConfirmButtonStyle}"
                            Margin="0,14,0,0"
                            Content="+ Add Transaction"
                            Command="{Binding AddCommand}"/>
                </Grid>
            </Border>
            
            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Transactions}"
                      AutoGenerateColumns="False"
                      GridLinesVisibility="Horizontal"
                      Style="{StaticResource TransactionsStyle}"
                      FontFamily="Resources/Fonts/#Geom"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NAME" 
                                        Binding="{Binding TransactionName}" Width="*"/>
                    <DataGridTextColumn Header="DATE" 
                                        Binding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}" Width="160"/>
                    <DataGridTextColumn Header="AMOUNT" 
                                        Binding="{Binding Amount, StringFormat='₪{0:F2}'}" Width="140"/>
                    <DataGridTemplateColumn Header="CATEGORY" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- ReSharper disable once Xaml.BindingWithContextNotResolved -->
                                <ComboBox BorderThickness="0"
                                          Background="{Binding Category, Converter={StaticResource CategoryBrush}}"
                                          ItemsSource="{x:Static models:Categories.All}"
                                          SelectedItem="{Binding Category, 
                                          UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource CategoryComboBoxStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
        </Grid>
    </Border>
</UserControl>
