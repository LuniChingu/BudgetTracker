<UserControl x:Class="BudgetTracker.Views.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="1000" d:DesignWidth="687">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
                            
        <GroupBox Header="Add New Transaction" Grid.Row="0"
                  Margin="10, 10, 10, 5"
                  Foreground="AliceBlue" 
                  Style="{StaticResource GenericGroupBox}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                                    
                <StackPanel Orientation="Horizontal" Grid.Row="0">
                    <TextBlock Text="Name: " VerticalAlignment="Center"/>
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="8,0,8,0" Height="25" Width="100"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="Date: " VerticalAlignment="Center"/>
                    <DatePicker Margin="5,0,5,0" Width="110" SelectedDate="{Binding NewDate}"/>
                    <TextBlock Text="Amount: " VerticalAlignment="Center"/>
                    <TextBox Text="{Binding NewAmount, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                             Margin="5,0,5,0" Width="100"/>
                    <TextBlock Text="Category: " VerticalAlignment="Center"/>
                    <ComboBox Style="{StaticResource RoundedComboBoxStyle}"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                              ItemsSource="{Binding CategoryOptions}"
                              SelectedItem="{Binding NewCategory}"
                              Margin="5,0,5,0" Width="100"
                              FontFamily="Resources/Fonts/#Lexend"/>
                </StackPanel>
                                    
                <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="10">
                    <Button Content="Add Transaction"
                            Command="{Binding AddCommand}"
                            Padding="5,0" 
                            Style="{StaticResource GenericBtn}"
                            FontFamily="Resources/Fonts/#Geom"/>
                </StackPanel>
            </Grid>
        </GroupBox>
        <GroupBox Header="Transactions" Grid.Row="1"
                  Margin="10, 5, 10, 10"
                  Foreground="AliceBlue"
                  FontFamily="Resources/Fonts/#Lexend"
                  Style="{StaticResource GenericGroupBox}">
            <DataGrid x:Name="dgTransactions"
                      AutoGenerateColumns="False"
                      GridLinesVisibility="Horizontal"
                      Style="{DynamicResource TransactionsStyle}"
                      FontFamily="Resources/Fonts/#Lexend"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120"/>
                    <DataGridTextColumn Header="AMOUNT" Binding="{Binding Amount, StringFormat='${0:F2}'}" Width="100"/>
                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="120"/>
                </DataGrid.Columns>
                                    
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
